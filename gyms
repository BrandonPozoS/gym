<script>
  (function initSmartNutrition() {
    const weightSlider = document.getElementById('weightRange');
    const weightDisplay = document.getElementById('currentWeightDisplay');
    const targetKcal = document.getElementById('targetKcal');
    const valProtein = document.getElementById('valProtein');
    const valCarbs = document.getElementById('valCarbs');
    const valFats = document.getElementById('valFats');
    const barProtein = document.getElementById('barProtein');
    const barCarbs = document.getElementById('barCarbs');
    const barFats = document.getElementById('barFats');
    const goalButtons = document.querySelectorAll('.goal-btn');
    const recalculateBtn = document.getElementById('btnRecalculate');
    const waterAddBtn = document.getElementById('btnWaterAdd');
    const hydroDisplay = document.getElementById('hydroConsumed');
    const toast = document.getElementById('toastNotification');
    const toastMsg = document.getElementById('toastMsg');

    let currentGoal = 'bulk';
    let waterConsumed = 2.4;

    function showToast(msg) {
      toastMsg.innerText = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
      }, 2400);
    }

    function calculateMetrics() {
      const weight = parseFloat(weightSlider.value);
      weightDisplay.innerText = weight.toFixed(1);

      let multKcal = 32;
      let pRatio = 2.2;
      let fRatio = 0.85;

      if (currentGoal === 'cut') {
        multKcal = 26;
        pRatio = 2.4;
        fRatio = 0.75;
      } else if (currentGoal === 'bulk') {
        multKcal = 34;
        pRatio = 2.2;
        fRatio = 0.9;
      } else {
        multKcal = 30;
        pRatio = 2.0;
        fRatio = 0.8;
      }

      const totalCalories = Math.round(weight * multKcal);
      const proteinG = Math.round(weight * pRatio);
      const fatG = Math.round(weight * fRatio);
      const remainingCalsForCarbs = Math.max(0, totalCalories - (proteinG * 4 + fatG * 9));
      const carbG = Math.round(remainingCalsForCarbs / 4);

      targetKcal.innerText = totalCalories.toLocaleString();
      valProtein.innerText = proteinG;
      valCarbs.innerText = carbG;
      valFats.innerText = fatG;

      barProtein.style.width = Math.min(100, Math.round((proteinG / 220) * 100)) + '%';
      barCarbs.style.width = Math.min(100, Math.round((carbG / 280) * 100)) + '%';
      barFats.style.width = Math.min(100, Math.round((fatG / 90) * 100)) + '%';
    }

    weightSlider.addEventListener('input', calculateMetrics);

    goalButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        goalButtons.forEach(b => {
          b.classList.remove('bg-primary-container', 'text-surface-container-lowest', 'font-bold');
          b.classList.add('bg-surface-container', 'text-on-surface-variant');
        });
        btn.classList.add('bg-primary-container', 'text-surface-container-lowest', 'font-bold');
        btn.classList.remove('bg-surface-container', 'text-on-surface-variant');
        currentGoal = btn.dataset.goal;
        calculateMetrics();
      });
    });

    recalculateBtn.addEventListener('click', () => {
      calculateMetrics();
      showToast('Plan recalibrado a ' + targetKcal.innerText + ' kcal diarias');
    });

    waterAddBtn.addEventListener('click', () => {
      if (waterConsumed < 3.2) {
        waterConsumed = Math.min(3.2, parseFloat((waterConsumed + 0.25).toFixed(2)));
        hydroDisplay.innerText = waterConsumed.toFixed(1);
        if (waterConsumed >= 2.65) {
          const s7 = document.getElementById('waterSlot7');
          if (s7) s7.className = 'h-2 rounded-full bg-secondary';
        }
        if (waterConsumed >= 3.1) {
          const s8 = document.getElementById('waterSlot8');
          if (s8) s8.className = 'h-2 rounded-full bg-secondary';
        }
        showToast('+250ml añadido a tu hidratación');
      } else {
        showToast('¡Meta diaria de 3.2L completada!');
      }
    });

    // Meal complete toggles
    document.querySelectorAll('.meal-toggle-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const isDone = this.getAttribute('data-done') === 'true';
        if (!isDone) {
          this.setAttribute('data-done', 'true');
          this.classList.remove('bg-surface-container-high', 'text-primary-container');
          this.classList.add('bg-primary-container', 'text-surface-container-lowest');
          this.innerHTML = '<span class="material-symbols-outlined text-[18px]">done_all</span><span>¡Comida Registrada!</span>';
          showToast('Toma registrada correctamente');
        } else {
          this.setAttribute('data-done', 'false');
          this.classList.add('bg-surface-container-high', 'text-primary-container');
          this.classList.remove('bg-primary-container', 'text-surface-container-lowest');
          this.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span><span>Marcar como Comido</span>';
        }
      });
    });

    // Recipe substitution feedback
    document.querySelectorAll('.swap-recipe-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        showToast('Buscando alternativa con macros equivalentes...');
      });
    });

    document.getElementById('btnGroceryList').addEventListener('click', () => {
      showToast('Generando lista para 7 días...');
    });
  })();
