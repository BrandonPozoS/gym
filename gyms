        // Start countdown simulation
        secondsLeft = 90;
        timerInterval = setInterval(() => {
          secondsLeft--;
          if (secondsLeft <= 0) secondsLeft = 90;
          const mins = Math.floor(secondsLeft / 60);
          const secs = secondsLeft % 60;
          timerDisplay.textContent = `Descanso: ${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }, 1000);
      } else {
        clearInterval(timerInterval);
        startBtn.classList.remove('bg-error', 'text-on-error');
        startBtn.classList.add('bg-primary-container', 'text-on-primary-fixed');
