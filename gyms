<script>
  let sessionSeconds = 24 * 60 + 18;
  let restSeconds = 75;
  let restMax = 90;
  let weight = 55.0;
  let reps = 10;
  let isPaused = false;

  // Session clock tick
  setInterval(() => {
    if (!isPaused) {
      sessionSeconds++;
      const mins = Math.floor(sessionSeconds / 60).toString().padStart(2, '0');
      const secs = (sessionSeconds % 60).toString().padStart(2, '0');
      const timerEl = document.getElementById('sessionTimer');
      if (timerEl) timerEl.textContent = `${mins}:${secs}`;
    }
  }, 1000);

  // Rest timer countdown
  const restInterval = setInterval(() => {
    if (!isPaused && restSeconds > 0) {
      restSeconds--;
      updateRestDisplay();
    }
  }, 1000);

  function updateRestDisplay() {
    const mins = Math.floor(restSeconds / 60).toString().padStart(2, '0');
    const secs = (restSeconds % 60).toString().padStart(2, '0');
    const restCounter = document.getElementById('restCounter');
    const restRing = document.getElementById('restRing');
    
    if (restCounter) restCounter.textContent = `${mins}:${secs}`;
    
    if (restRing) {
      const circumference = 188.4;
      const progress = restSeconds / restMax;
      const offset = circumference * (1 - progress);
      restRing.style.strokeDashoffset = offset;
    }
  }

  function adjustRest(delta) {
    restSeconds = Math.max(0, restSeconds + delta);
    if (restSeconds > restMax) restMax = restSeconds;
    updateRestDisplay();
  }

  function skipRest() {
    restSeconds = 0;
    updateRestDisplay();
  }

  function adjustWeight(delta) {
    weight = Math.max(0, parseFloat((weight + delta).toFixed(1)));
    const weightDisplay = document.getElementById('weightDisplay');
    if (weightDisplay) weightDisplay.textContent = weight.toFixed(1);
  }

  function adjustReps(delta) {
    reps = Math.max(1, reps + delta);
    const repsDisplay = document.getElementById('repsDisplay');
    if (repsDisplay) repsDisplay.textContent = reps;
  }

  function completeActiveSet() {
    const btn = document.getElementById('completeSetBtn');
    if (btn) {
      btn.innerHTML = `<span class="material-symbols-outlined text-[24px]">verified</span> ¡Serie Guardada!`;
      btn.classList.replace('bg-primary-container', 'bg-surface-tint');
      setTimeout(() => {
        restSeconds = 90;
        restMax = 90;
        updateRestDisplay();
      }, 300);
    }
  }

  function togglePlateCalculator() {
    alert(`Cálculo de barra (55kg):\nBarra olímpica (20kg) + Disco 15kg y Disco 2.5kg por cada lado.`);
  }

  function nextExercise() {
    alert("Cargando: Curl con Mancuernas Alterno...");
  }

  function confirmEndSession() {
    const modal = document.getElementById('endSessionModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeEndModal() {
    const modal = document.getElementById('endSessionModal');
    if (modal) modal.classList.add('hidden');
  }

  function finalizeWorkout() {
    closeEndModal();
    alert("¡Entrenamiento finalizado! Sincronizando datos biométricos y guardando progreso...");
  }

  const pauseBtn = document.getElementById('pauseSessionBtn');
  if (pauseBtn) {
    pauseBtn.addEventListener('click', () => {
      isPaused = !isPaused;
      const icon = document.getElementById('pauseIcon');
      if (icon) icon.textContent = isPaused ? 'play_arrow' : 'pause';
    });
  }
</script></main></body></html>
